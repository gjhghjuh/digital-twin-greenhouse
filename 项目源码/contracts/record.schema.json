{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "snapshot",
        "event"
      ]
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "bootId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stateVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "utcMs": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "uptimeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timeQuality": {
      "enum": [
        "SYNCED",
        "UNSYNCED"
      ]
    },
    "configVersion": {
      "const": 1
    },
    "modelVersion": {
      "const": 1
    },
    "temperature": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -55,
              "maximum": 125
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "const": "SENSOR"
        },
        "validity": {
          "enum": [
            "VALID",
            "NOT_READY",
            "READ_ERROR"
          ]
        },
        "sampledAtUtcMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "uptimeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "value",
        "source",
        "validity",
        "sampledAtUtcMs",
        "uptimeMs"
      ],
      "additionalProperties": false
    },
    "humidity": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "const": "SENSOR"
        },
        "validity": {
          "enum": [
            "VALID",
            "NOT_READY",
            "READ_ERROR"
          ]
        },
        "sampledAtUtcMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "uptimeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "value",
        "source",
        "validity",
        "sampledAtUtcMs",
        "uptimeMs"
      ],
      "additionalProperties": false
    },
    "lightLevel": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "const": "EXPERIMENT"
        },
        "validity": {
          "enum": [
            "VALID",
            "NOT_READY",
            "READ_ERROR"
          ]
        },
        "sampledAtUtcMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "uptimeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "value",
        "source",
        "validity",
        "sampledAtUtcMs",
        "uptimeMs"
      ],
      "additionalProperties": false
    },
    "soilHumidity": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "const": "SIMULATION"
        },
        "validity": {
          "enum": [
            "VALID",
            "NOT_READY",
            "READ_ERROR"
          ]
        },
        "sampledAtUtcMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "uptimeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "value",
        "source",
        "validity",
        "sampledAtUtcMs",
        "uptimeMs"
      ],
      "additionalProperties": false
    },
    "pump": {
      "type": "boolean"
    },
    "lamp": {
      "type": "boolean"
    },
    "fan": {
      "type": "boolean"
    },
    "wifiConnected": {
      "type": "boolean"
    },
    "cloudConnected": {
      "type": "boolean"
    },
    "pumpMode": {
      "enum": [
        "MANUAL",
        "AUTO"
      ]
    },
    "lampMode": {
      "enum": [
        "MANUAL",
        "AUTO"
      ]
    },
    "fanMode": {
      "enum": [
        "MANUAL",
        "AUTO"
      ]
    },
    "lightAdcRaw": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4095
    },
    "lightAdcFiltered": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4095
    },
    "lastCommandId": {
      "type": "string",
      "maxLength": 512
    },
    "lastCommandResult": {
      "type": "string",
      "maxLength": 512
    },
    "eventId": {
      "type": "string",
      "maxLength": 512
    },
    "eventType": {
      "type": "string",
      "maxLength": 512
    },
    "target": {
      "type": "string",
      "maxLength": 512
    },
    "commandId": {
      "type": "string",
      "maxLength": 512
    },
    "reason": {
      "type": "string",
      "maxLength": 512
    },
    "operator": {
      "type": "string",
      "maxLength": 512
    },
    "oldValue": {
      "type": [
        "string",
        "number",
        "boolean",
        "null",
        "object"
      ]
    },
    "newValue": {
      "type": [
        "string",
        "number",
        "boolean",
        "null",
        "object"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "deviceId",
    "bootId",
    "seq",
    "stateVersion",
    "utcMs",
    "uptimeMs",
    "timeQuality",
    "configVersion",
    "modelVersion"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "snapshot"
          }
        }
      },
      "then": {
        "required": [
          "temperature",
          "humidity",
          "lightLevel",
          "soilHumidity",
          "lightAdcRaw",
          "lightAdcFiltered",
          "pump",
          "lamp",
          "fan",
          "pumpMode",
          "lampMode",
          "fanMode",
          "wifiConnected",
          "cloudConnected",
          "lastCommandId",
          "lastCommandResult"
        ]
      },
      "else": {
        "required": [
          "eventId",
          "eventType",
          "target",
          "oldValue",
          "newValue",
          "commandId",
          "reason",
          "operator"
        ]
      }
    }
  ]
}
